#!/usr/bin/env bash
# Hipo Ai launcher for Termux/Linux.
# Resolves symlinks so it still works if linked to $PREFIX/bin/hipo.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
python "$DIR/hipo.py" "$@"
